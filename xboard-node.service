[Unit]
Description=xboard-node (proxy node agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/xboard-node
ExecStart=/opt/xboard-node/xboard-node -c /etc/xboard-node/config.yml
Restart=always
RestartSec=2
# Proxy kernels (sing-box/xray) open many sockets and need network privileges.

User=root
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
# Hot-reload: the agent watches config.yml, so `systemctl reload` isn't required
# for config changes; the panel also pushes config over WebSocket in real time.

[Install]
WantedBy=multi-user.target
