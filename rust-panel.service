[Unit]
Description=rust-panel (proxy-service management panel)
Documentation=https://github.com/Wangin1996/rustpanel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rust-panel
EnvironmentFile=/etc/rust-panel/panel.env
ExecStart=/opt/rust-panel/rust-panel
User=rust-panel
Group=rust-panel
# The in-panel restart action exits cleanly; Restart=always relaunches it.
Restart=always
RestartSec=1
# Give the database and sockets a moment to close.
TimeoutStopSec=10
LimitNOFILE=1048576
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=rust-panel
ReadWritePaths=/var/lib/rust-panel
UMask=0077

[Install]
WantedBy=multi-user.target
